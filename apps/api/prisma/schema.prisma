generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(80)
  email        String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  rating       Int      @default(1000)
  xp           Int      @default(0)
  createdAt    DateTime @default(now())
  sessions     Session[]
  lessons      LessonProgress[]
  puzzles      PuzzleAttempt[]
  activities   Activity[]
  studyReviews StudyReview[]
  studyEvents  StudyEvent[]
  puzzlePractices PuzzlePractice[]
  repertoires UserRepertoire[]
  gameImports OpeningGameImport[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(64)
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Lesson {
  id          String @id
  slug        String @unique
  title       String
  category    String
  level       String
  description String @db.Text
  sortOrder   Int
  minutes     Int
  steps       Json
  quiz        Json
  progress    LessonProgress[]
  @@index([category, sortOrder])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  @@unique([userId, lessonId])
}

model Opening {
  id        String @id
  eco       String @db.VarChar(3)
  name      String @db.VarChar(500)
  family    String
  pgn       String @db.Text
  fen       String
  moves     Json
  sourceUrl String @db.VarChar(500)
  positions OpeningPosition[]
  @@index([eco])
  @@index([family])
}

model OpeningPosition {
  key         String   @id @db.VarChar(64)
  fen         String
  openingId   String
  ply         Int
  title       String   @db.VarChar(500)
  explanation String   @db.Text
  createdAt   DateTime @default(now())
  opening     Opening  @relation(fields: [openingId], references: [id], onDelete: Cascade)
  @@index([openingId, ply])
}

model UserRepertoire {
  id         String   @id @default(cuid())
  userId     String
  courseId   String   @db.VarChar(80)
  selectedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
  @@index([userId, selectedAt])
}

model OpeningGameImport {
  id             String   @id @default(cuid())
  userId         String
  platform       String   @db.VarChar(12)
  username       String   @db.VarChar(80)
  gameExternalId String   @db.VarChar(191)
  playedAt       DateTime?
  color          String   @db.VarChar(1)
  openingId      String?  @db.VarChar(191)
  firstMissPly   Int?
  summary        String   @db.Text
  importedAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, platform, gameExternalId])
  @@index([userId, importedAt])
}

/// Editorial guidance is stored by opening family so every variation inherits
/// the same strategic foundation without pretending that a family guide is a
/// move-by-move evaluation of that variation.
model OpeningGuide {
  family         String @id @db.VarChar(191)
  overview       String @db.Text
  whitePlan      Json
  blackPlan      Json
  commonMistakes Json
  lessonIds      Json
  updatedAt      DateTime @updatedAt
}

model Puzzle {
  /// Lichess PuzzleId is base62 and case-sensitive. Migration uses utf8mb4_bin.
  id        String @id
  rating    Int
  themes    Json
  fen       String
  moves     Json
  sourceUrl String @db.VarChar(500)
  attempts  PuzzleAttempt[]
  @@index([rating])
}

model PuzzleAttempt {
  id        String    @id @default(cuid())
  userId    String
  /// Must use the same case-sensitive collation as Puzzle.id.
  puzzleId  String
  solved    Boolean   @default(false)
  hintUsed  Boolean   @default(false)
  mistakes  Int       @default(0)
  solvedAt  DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzle    Puzzle    @relation(fields: [puzzleId], references: [id])
  @@unique([userId, puzzleId])
}

model Endgame {
  id          String @id
  slug        String @unique
  title       String
  description String @db.Text
  fen         String
  goal        String
  level       String
  side        String @db.VarChar(1)
  tips        Json
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model StudyReview {
  id String @id @default(cuid())
  userId String
  kind String @db.VarChar(12)
  contentId String @db.VarChar(191)
  side String @default("") @db.VarChar(1)
  stage Int @default(0)
  repetitions Int @default(0)
  dueAt DateTime
  lastStudiedAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, kind, contentId, side])
  @@index([userId, dueAt])
}

model StudyEvent {
  id String @id @default(cuid())
  userId String
  requestId String @db.VarChar(100)
  kind String @db.VarChar(12)
  contentId String @db.VarChar(191)
  side String @default("") @db.VarChar(1)
  completed Boolean
  success Boolean
  mistakes Int @default(0)
  hintUsed Boolean @default(false)
  rating Int
  result Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, requestId])
  @@index([userId, createdAt])
}

model PuzzlePractice {
  id String @id @default(cuid())
  userId String
  puzzleId String @db.VarChar(191)
  practiceId String @db.VarChar(100)
  mistakes Int @default(0)
  hintUsed Boolean @default(false)
  solved Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, puzzleId, practiceId])
}
